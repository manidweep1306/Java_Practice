import java.util.*;

class Main {
    public static void main(String[] args) {

        Scanner s = new Scanner(System.in);

        System.out.print("Enter a value: ");

        if (s.hasNextInt()) {
            int num = s.nextInt();
            System.out.println(num + " is an Integer");
        } else {
            System.out.println("Entered value is not an Integer");
        }
    }
}
